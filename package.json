{
  "name": "xmartinez",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "generate-pdf": "ts-node-esm --project tsconfig-pdf.json ./scripts/generate-pdf.ts",
    "generate-pdf:ci": "start-test preview http://localhost:4321 generate-pdf",
    "build": "astro check && tsc --noEmit && astro build && npm run generate-pdf:ci",
    "preview": "astro preview",
    "astro": "astro"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "@astrojs/tailwind": "^5.0.3",
    "@tailwindcss/typography": "^0.5.10",
    "@tsconfig/node18": "^18.2.2",
    "@types/node": "^20.10.5",
    "astro": "^4.0.6",
    "playwright": "^1.40.1",
    "prettier": "^3.1.1",
    "prettier-plugin-tailwindcss": "^0.5.9",
    "start-server-and-test": "^2.0.3",
    "tailwindcss": "^3.3.6",
    "ts-node": "^10.9.2"
  },
  "dependencies": {
    "@astrojs/check": "^0.5.0",
    "typescript": "^5.3.3"
  }
}
