{
  "name": "xmartinez",
  "version": "0.0.1",
  "private": true,
  "description": "Personal site and CV for Xabier Martinez. Built with Astro and Tailwind.",
  "type": "module",
  "scripts": {
    "astro": "astro",
    "build": "npm run type-check && astro build && npm run generate-pdf:ci",
    "deploy": "npm run build && wrangler deploy",
    "dev": "astro dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "generate-pdf": "node ./scripts/generate-pdf.js",
    "generate-pdf:ci": "astro preview --background && sleep 2 && npm run generate-pdf; s=$?; astro preview stop; exit $s",
    "lint": "oxlint",
    "ncu": "ncu -u",
    "preview": "astro preview",
    "start": "astro dev",
    "type-check": "tsc --noEmit",
    "validate": "npm run format:check && npm run lint && npm run type-check",
    "lint:fix": "oxlint --fix"
  },
  "devDependencies": {
    "@fontsource-variable/schibsted-grotesk": "^5.3.0",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.5",
    "astro": "^7.4.8",
    "oxlint": "latest",
    "playwright": "^1.65.0",
    "prettier": "3.9.10",
    "prettier-plugin-astro": "1.1.2",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.5",
    "typescript": "7.0.2",
    "wrangler": "^4.159.0"
  },
  "engines": {
    "node": ">=26.13.0"
  },
  "overrides": {
    "postcss-selector-parser": "^7.2.0",
    "postcss": "^8.5.32",
    "minimatch": "^11.0.5"
  }
}
