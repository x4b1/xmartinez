{
  "name": "xmartinez",
  "version": "0.0.1",
  "private": true,
  "description": "Personal site and CV for Xabier Martinez. Built with Astro and Tailwind.",
  "type": "module",
  "scripts": {
    "astro": "astro",
    "build": "astro check && tsc --noEmit && astro build && npm run generate-pdf:ci",
    "deploy": "npm run build && wrangler deploy",
    "dev": "astro dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "generate-pdf": "node ./scripts/generate-pdf.js",
    "generate-pdf:ci": "start-test preview http://localhost:4321 generate-pdf",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "ncu": "ncu -u",
    "preview": "astro preview",
    "start": "astro dev",
    "type-check": "astro check && tsc --noEmit",
    "validate": "npm run format:check && npm run lint && npm run type-check"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.7",
    "@eslint/js": "^10.0.1",
    "@fontsource-variable/roboto": "^5.2.10",
    "@tailwindcss/typography": "^0.5.19",
    "@tailwindcss/vite": "^4.2.1",
    "@typescript-eslint/parser": "^8.57.0",
    "astro": "^7.0.0",
    "astro-eslint-parser": "^3.0.0",
    "eslint": "^10.0.3",
    "eslint-plugin-astro": "^3.0.0",
    "playwright": "^1.58.2",
    "prettier": "3.9.6",
    "prettier-plugin-astro": "0.14.1",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "start-server-and-test": "^3.0.0",
    "tailwindcss": "^4.2.1",
    "typescript": "^7.0.0",
    "typescript-eslint": "^8.57.0",
    "wrangler": "^4.73.0"
  },
  "engines": {
    "node": ">=22.14.0"
  }
}
