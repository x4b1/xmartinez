{
  "name": "xmartinez",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "generate-pdf": "ts-node --project tsconfig-pdf.json ./scripts/generate-pdf.ts",
    "generate-pdf:ci": "start-server-and-test http://localhost:3000 generate-pdf",
    "build": "astro check && tsc --noEmit && npm run generate-pdf:ci && astro build",
    "astro": "astro"
  },
  "devDependencies": {
    "@astrojs/tailwind": "^4.0.0",
    "@tailwindcss/typography": "^0.5.9",
    "@types/node": "^20.5.0",
    "astro": "^2.10.8",
    "playwright": "^1.37.0",
    "prettier": "^3.0.1",
    "prettier-plugin-tailwindcss": "^0.5.3",
    "start-server-and-test": "^2.0.0",
    "tailwindcss": "^3.3.3",
    "ts-node": "^10.9.1"
  }
}
