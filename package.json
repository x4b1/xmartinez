{
  "name": "xmartinez",
  "version": "0.0.1",
  "private": true,
  "description": "Personal site and CV for Xabier Martinez. Built with Astro and Tailwind.",
  "type": "module",
  "scripts": {
    "astro": "astro",
    "build": "astro check && tsc --noEmit && astro build && npm run generate-pdf:ci",
    "deploy": "npm run build && wrangler deploy",
    "dev": "astro dev",
    "format": "prettier --write .",
    "generate-pdf": "node ./scripts/generate-pdf.js",
    "generate-pdf:ci": "start-test preview http://localhost:4321 generate-pdf",
    "lint": "prettier --check .",
    "ncu": "ncu -u",
    "preview": "astro preview",
    "start": "astro dev"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "@fontsource-variable/roboto": "^5.2.8",
    "@tailwindcss/typography": "^0.5.19",
    "@tailwindcss/vite": "^4.1.14",
    "astro": "^5.14.1",
    "playwright": "^1.55.1",
    "prettier": "3.6.2",
    "prettier-plugin-astro": "0.14.1",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "start-server-and-test": "^2.1.2",
    "tailwindcss": "^4.1.14",
    "typescript": "^5.9.3",
    "wrangler": "^4.42.0"
  },
  "engines": {
    "node": ">=22.14.0"
  }
}
