---
import type { Education, Labels, Project } from "~/types/cv";

type Props = {
  name: string;
  jobDescription: string;
  location: string;
  email: string;
  website: string;
  github: string;
  linkedin: string;
  education: Education[];
  languages: string[];
  projects: Project[];
  labels: Labels;
};

const {
  name,
  jobDescription,
  location,
  email,
  website,
  github,
  linkedin,
  education,
  languages,
  projects,
  labels,
} = Astro.props;

const shorten = (url: string) => url.replace(/^https?:\/\/(www\.)?/, "");

type Detail = {
  key: string;
  text: string;
  link?: string;
};

const details: Detail[] = [
  {
    key: labels.location,
    text: location,
  },
  {
    key: labels.email,
    text: email,
    link: `mailto:${email}`,
  },
  {
    key: labels.linkedin,
    text: shorten(linkedin),
    link: linkedin,
  },
  {
    key: labels.github,
    text: shorten(github),
    link: github,
  },
  {
    key: labels.website,
    text: shorten(website),
    link: website,
  },
];
---

<section class="flex h-full flex-col bg-[#101a28] px-4 py-4 text-white print:px-[9mm] print:py-[9mm]">
  <div class="mb-4">
    <h1 class="text-2xl leading-none font-extrabold tracking-tight">{name}</h1>
    <p class="text-base">{jobDescription}</p>
  </div>

  <dl class="flex flex-col space-y-2">
    {details.map((detail) => (
      <div>
        <dt class="font-semibold">{detail.key}</dt>
        <dd>
          {detail.link ? (
            <a
              class="font-normal underline-offset-2 hover:underline"
              target="_blank"
              href={detail.link}
              rel="noopener noreferrer"
            >
              {detail.text}
            </a>
          ) : (
            <span>{detail.text}</span>
          )}
        </dd>
      </div>
    ))}
  </dl>

  <hr class="my-4 border-0 border-t border-gray-200" />

  <h2 class="mb-2 text-lg font-extrabold">{labels.education}</h2>
  <div class="flex flex-col gap-y-2">
    {education.map((ed) => (
      <div>
        <h3 class="font-bold">{ed.title}</h3>
        <h4>{ed.place}</h4>
        <span class="text-slate-300 italic">
          {ed.startDate} - {ed.endDate}
        </span>
      </div>
    ))}
  </div>

  <hr class="my-4 border-0 border-t border-gray-200" />

  <h2 class="mb-2 text-lg font-extrabold">{labels.languages}</h2>
  <ul class="flex list-none md:flex-col md:space-y-2 print:flex-col">
    {languages.map((s) => (
      <li class="w-full">{s}</li>
    ))}
  </ul>

  <hr class="my-4 border-0 border-t border-gray-200" />

  <h2 class="mb-2 text-lg font-extrabold">{labels.projects}</h2>
  <div class="flex flex-col gap-y-2">
    {projects.map((p) => (
      <div>
        <h3 class="font-bold">{p.title}</h3>
        <p class="mb-1 text-slate-300">{p.description}</p>
        <a
          class="underline-offset-2 hover:underline"
          href={p.link}
          target="_blank"
          rel="noopener noreferrer"
        >
          {shorten(p.link)}
        </a>
      </div>
    ))}
  </div>
</section>
