---
type Props = {
  name: string;
  jobDescription: string;
  location: string;
  email: string;
  website: string;
  github: string;
  linkedin: string;
  education: Education[];
  languages: string[];
};

const {
  name,
  jobDescription,
  location,
  email,
  website,
  github,
  linkedin,
  education,
  languages,
} = Astro.props;

type Education = {
  title: string;
  place: string;
  startDate: string;
  endDate: string;
};

type Detail = {
  key: string;
  text: string;
  link?: string;
};

const details: Detail[] = [
  {
    key: "Location",
    text: location,
  },
  {
    key: "Email",
    text: email,
    link: `mailto:${email}`,
  },
  {
    key: "Linkedin",
    text: linkedin,
    link: linkedin,
  },
  {
    key: "GitHub",
    text: github,
    link: github,
  },
  {
    key: "Website",
    text: website,
    link: website,
  },
];
---

<section class="flex h-full flex-col bg-slate-600 px-4 py-2 text-white">
  <div class="mt-2 mb-4">
    <h1 class="text-2xl leading-none font-extrabold tracking-tight">
      {name}
    </h1>
    <h2 class="text-base">
      {jobDescription}
    </h2>
  </div>

  <dl class="flex flex-col justify-start space-y-2">
    {
      details.map((detail) => (
        <div class="xs:w-1/2">
          <dt class="mb-0 font-semibold">{detail.key}</dt>
          <dd>
            {detail.link ? (
              <a
                class="font-normal"
                target="_blank"
                href={detail.link}
                rel="noopener noreferrer"
              >
                {detail.text}
              </a>
            ) : (
              <span>{detail.text}</span>
            )}
          </dd>
        </div>
      ))
    }
  </dl>

  <hr class="my-4 h-px border-0 bg-gray-200" />

  <h2 class="mb-2 text-lg font-extrabold">Education</h2>
  {
    education.map((ed) => (
      <>
        <h3 class="font-bold">{ed.title}</h3>
        <h4>{ed.place}</h4>
        <span class="text-slate-300 italic">
          {ed.startDate} - {ed.endDate}
        </span>
      </>
    ))
  }
  <hr class="my-4 h-px border-0 bg-gray-200" />

  <h2 class="mb-2 text-lg font-extrabold">Languages</h2>
  <ul
    class="flex flex-none list-inside list-none md:flex-col md:space-y-3 print:flex-col print:space-y-3"
  >
    {languages.map((s) => <li class="w-full">{s}</li>)}
  </ul>
</section>
