---
import type { Education, Labels } from "~/types/cv";

type Props = {
  name: string;
  jobDescription: string;
  location: string;
  email: string;
  website: string;
  github: string;
  linkedin: string;
  education: Education[];
  languages: string[];
  labels: Labels;
};

const {
  name,
  jobDescription,
  location,
  email,
  website,
  github,
  linkedin,
  education,
  languages,
  labels,
} = Astro.props;

type Detail = {
  key: string;
  text: string;
  link?: string;
};

const details: Detail[] = [
  {
    key: labels.location,
    text: location,
  },
  {
    key: labels.email,
    text: email,
    link: `mailto:${email}`,
  },
  {
    key: labels.linkedin,
    text: linkedin,
    link: linkedin,
  },
  {
    key: labels.github,
    text: github,
    link: github,
  },
  {
    key: labels.website,
    text: website,
    link: website,
  },
];
---

<section class="flex h-full flex-col bg-slate-600 px-4 py-2 text-white">
  <div class="mt-2 mb-4">
    <h1 class="text-2xl leading-none font-extrabold tracking-tight">
      {name}
    </h1>
    <h2 class="text-base">
      {jobDescription}
    </h2>
  </div>

  <dl class="flex flex-col space-y-2">
    {
      details.map((detail) => (
        <div>
          <dt class="font-semibold">{detail.key}</dt>
          <dd>
            {detail.link ? (
              <a
                class="font-normal underline-offset-2 hover:underline"
                target="_blank"
                href={detail.link}
                rel="noopener noreferrer"
              >
                {detail.text}
              </a>
            ) : (
              <span>{detail.text}</span>
            )}
          </dd>
        </div>
      ))
    }
  </dl>

  <hr class="my-4 border-0 border-t border-gray-200" />

  <h2 class="mb-2 text-lg font-extrabold">{labels.education}</h2>
  {
    education.map((ed) => (
      <>
        <h3 class="font-bold">{ed.title}</h3>
        <h4>{ed.place}</h4>
        <span class="text-slate-300 italic">
          {ed.startDate} - {ed.endDate}
        </span>
      </>
    ))
  }
  <hr class="my-4 border-0 border-t border-gray-200" />

  <h2 class="mb-2 text-lg font-extrabold">{labels.languages}</h2>
  <ul class="flex list-none md:flex-col md:space-y-3 print:flex-col">
    {languages.map((s) => <li class="w-full">{s}</li>)}
  </ul>
</section>
