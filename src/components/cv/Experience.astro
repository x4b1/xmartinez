---
type Props = {
  experience: ExperienceLine[];
  website: string;
};

type ExperienceLine = {
  company: string;
  url: string;
  title: string;
  startDate: string;
  endDate: string;
  description: string[];
  tags: string[];
};

const { experience, website } = Astro.props;
---

<section class="flex h-full grow flex-col overflow-hidden">
  <h2 class="mb-2 text-lg font-extrabold">Work Experience</h2>
  <div class="flex flex-col flex-wrap gap-y-4 overflow-hidden">
    {
      experience.map((line) => {
        return (
          <div>
            <div class="mb-1 flex justify-between">
              <h3 class="w-2/3">
                <span class="font-bold">{line.title}</span> @
                <a class="text-slate-600" href={line.url}>
                  {line.company}
                </a>
              </h3>
              <span class="text-slate-600 italic">
                {line.startDate} - {line.endDate}
              </span>
            </div>
            <ul class="mb-1">
              {line.description.map((item) => (
                <li class="flex space-x-2">
                  <svg
                    class="h-5 w-5 flex-shrink-0 text-slate-600"
                    fill="currentColor"
                    viewBox="0 0 20 20"
                    xmlns="http://www.w3.org/2000/svg"
                    aria-label="Checkmark"
                    role="img"
                  >
                    <title>Checkmark</title>
                    <path
                      fill-rule="evenodd"
                      d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z"
                      clip-rule="evenodd"
                    />
                  </svg>
                  <span>{item}</span>
                </li>
              ))}
            </ul>
            <div class="text-slate-600">{line.tags.join(" | ")}</div>
          </div>
        );
      })
    }
  </div>
  <div class="hidden h-6 text-center font-bold print:block">
    More experience at <a class="text-slate-600" href={website}>{website}</a>
  </div>
</section>
