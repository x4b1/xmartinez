---
type Props = {
  projects: Project[];
};

type Project = {
  title: string;
  description: string;
  link: string;
};

const { projects } = Astro.props;
---

<section>
  <h2 class="mb-2 text-lg font-extrabold">Projects</h2>
  <div class="flex flex-col flex-wrap gap-y-2 overflow-hidden">
    {
      projects.map((project) => {
        return (
          <div>
            <h3 class="w-2/3">
              <span class="font-bold">{project.title}</span>
            </h3>
            <p class="mb-1">{project.description}</p>
            <a
              class="text-slate-600"
              href={project.link}
              target="_blank"
              rel="noopener noreferrer"
            >
              {project.link}
            </a>
          </div>
        );
      })
    }
  </div>
</section>
