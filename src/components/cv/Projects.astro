---
import type { Project, Labels } from "~/types/cv";

type Props = {
  projects: Project[];
  labels: Labels;
};

const { projects, labels } = Astro.props;
---

<section>
  <h2 class="mb-2 text-lg font-extrabold">{labels.projects}</h2>
  <div class="flex flex-col gap-y-2 overflow-hidden">
    {
      projects.map((project) => {
        return (
          <div>
            <h3>
              <span class="font-bold">{project.title}</span>
            </h3>
            <p class="mb-1">{project.description}</p>
            <a
              class="text-slate-600 underline-offset-2 hover:underline"
              href={project.link}
              target="_blank"
              rel="noopener noreferrer"
            >
              {project.link}
            </a>
          </div>
        );
      })
    }
  </div>
</section>
