---
import BaseLayout from "../layouts/BaseLayout.astro";
import { info } from "../content/_cv";

const pdf = `/${info.name.toLowerCase().replaceAll(" ", "_")}.pdf`;
const ext = { target: "_blank", rel: "noopener noreferrer" };
const year = (d: string) => d.split(" ")[1] ?? d;
const years = (a: string, b: string) =>
  year(a) === year(b) ? year(a) : `${year(a)} – ${year(b)}`;
const nav = [
  ["about", "About"],
  ["projects", "Projects"],
  ["experience", "Experience"],
  ["education", "Education"],
];
---

<BaseLayout title={`${info.name} - ${info.jobDescription}`} seo={info.seo}>
  <div class="home">
    <aside>
      <h1>{info.name}</h1>
      <p class="role">{info.jobDescription}</p>
      <p class="pitch">
        Go, backend and infrastructure. Based in {info.location}.
      </p>

      <nav class="toc" aria-label="Sections">
        {nav.map(([id, label]) => (
          <a href={`#${id}`}>{label}</a>
        ))}
      </nav>

      <div class="social">
        <a href={pdf}>CV (PDF)</a>
        <a href={`mailto:${info.email}`}>Email</a>
        <a href={info.github} {...ext}>
          GitHub
        </a>
        <a href={info.linkedin} {...ext}>
          LinkedIn
        </a>
      </div>
    </aside>

    <main>
      <section id="about" aria-labelledby="h-about">
        <h2 id="h-about">About</h2>
        <div class="about">
          {info.about.map((p) => (
            <p>{p}</p>
          ))}
        </div>
      </section>

      <section id="projects" aria-labelledby="h-projects">
        <h2 id="h-projects">Projects</h2>
        {info.projects.map((p) => (
          <a class="proj" href={p.link} {...ext}>
            <h3>{p.title}</h3>
            <p>{p.description}</p>
          </a>
        ))}
      </section>

      <section id="experience" aria-labelledby="h-experience">
        <h2 id="h-experience">Experience</h2>
        <ol class="jobs">
          {info.experience.map((e) => (
            <li class="job">
              <span class="when">{years(e.startDate, e.endDate)}</span>
              <div>
                <h3>
                  {e.title} ·{" "}
                  <a href={e.url} {...ext}>
                    {e.company}
                  </a>
                </h3>
                <ul>
                  {e.description.map((d) => (
                    <li>{d}</li>
                  ))}
                </ul>
                <ul class="tags" aria-label="Technologies">
                  {e.tags.map((t) => (
                    <li>{t}</li>
                  ))}
                </ul>
              </div>
            </li>
          ))}
        </ol>
      </section>

      <section id="education" aria-labelledby="h-education">
        <h2 id="h-education">Education</h2>
        {info.education.map((ed) => (
          <p class="edu">
            <b>{ed.title}</b>, {ed.place}
            <span class="meta"> · {years(ed.startDate, ed.endDate)}</span>
          </p>
        ))}
        <p class="edu meta">Languages: {info.languages.join(", ")}</p>
      </section>
    </main>
  </div>

  <script is:inline>
    // Mark the nav link of the section in view.
    const links = [...document.querySelectorAll(".toc a")];
    const io = new IntersectionObserver(
      (es) =>
        es.forEach((e) => {
          if (e.isIntersecting)
            links.forEach((l) =>
              l.setAttribute(
                "aria-current",
                String(l.hash === "#" + e.target.id),
              ),
            );
        }),
      { rootMargin: "-35% 0px -60% 0px" },
    );
    links.forEach((l) => io.observe(document.querySelector(l.hash)));
  </script>
</BaseLayout>
