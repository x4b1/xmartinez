---
import BaseLayout from "../layouts/BaseLayout.astro";
import { info } from "../content/_cv";
---

<BaseLayout title={`${info.name} - ${info.jobDescription}`} seo={info.seo}>
  <div class="min-h-screen bg-slate-50">
    <main class="container mx-auto px-4 py-16 md:py-24">
      <!-- Hero Section -->
      <div class="mx-auto max-w-3xl text-center">
        <!-- Avatar -->
        <img
          src="/avatar.jpg"
          alt={info.name}
          class="mx-auto mb-8 h-32 w-32 rounded-full object-cover shadow-lg ring-4 ring-slate-200"
        />

        <!-- Name & Title -->
        <h1 class="mb-4 text-4xl font-bold text-slate-900 md:text-5xl">
          {info.name}
        </h1>
        <p class="mb-8 text-xl text-slate-600 md:text-2xl">
          {info.jobDescription}
        </p>

        <!-- About snippet -->
        <p class="mb-12 text-lg leading-relaxed text-slate-700">
          {info.about.join("\n")}
        </p>

        <!-- Navigation Cards -->
        <div class="grid gap-6 md:grid-cols-2">
          <!-- CV Card -->
          <a
            href="/cv"
            class="group rounded-xl border-2 border-slate-200 bg-white p-6 shadow-sm transition-all hover:border-slate-400 hover:shadow-md"
          >
            <svg
              class="mx-auto mb-3 h-12 w-12 text-slate-600 transition-transform group-hover:scale-110"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"
              ></path>
            </svg>
            <h2 class="mb-2 text-xl font-semibold text-slate-900">CV</h2>
            <p class="text-sm text-slate-600">View my resume and experience</p>
          </a>

          <!-- Blog Card (Coming Soon) -->
          <div
            class="rounded-xl border-2 border-slate-100 bg-slate-50 p-6 shadow-sm"
          >
            <svg
              class="mx-auto mb-3 h-12 w-12 text-slate-400"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z"
              ></path>
            </svg>
            <h2 class="mb-2 text-xl font-semibold text-slate-500">Blog</h2>
            <p class="text-sm text-slate-400">Coming soon</p>
          </div>
        </div>

        <!-- Social Links -->
        <div class="mt-12 flex justify-center gap-6">
          <a
            href={info.github}
            target="_blank"
            rel="noopener noreferrer"
            class="text-slate-600 transition-colors hover:text-slate-900"
            aria-label="GitHub"
          >
            <svg class="h-6 w-6" fill="currentColor" viewBox="0 0 24 24">
              <path
                d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"
              ></path>
            </svg>
          </a>
          <a
            href={info.linkedin}
            target="_blank"
            rel="noopener noreferrer"
            class="text-slate-600 transition-colors hover:text-slate-900"
            aria-label="LinkedIn"
          >
            <svg class="h-6 w-6" fill="currentColor" viewBox="0 0 24 24">
              <path
                d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"
              ></path>
            </svg>
          </a>
        </div>
      </div>
    </main>
  </div>
</BaseLayout>
