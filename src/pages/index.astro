---
import BaseLayout from "../layouts/BaseLayout.astro";

import Header from "../components/cv/Header.astro";
import Experience from "../components/cv/Experience.astro";
import Projects from "../components/cv/Projects.astro";
import Download from "../components/Download.astro";

import { info } from "../content/_cv";

function cvFileName(name: string): string {
  return `${name.toLowerCase().replaceAll(" ", "_")}.pdf`;
}
---

<BaseLayout title={info.name}>
  <div
    class="print:py-0 bg-indigo-50 print:block flex justify-center items-center"
  >
    <main
      class="w-a4 print:h-a4 m-0 shadow-md print:shadow-none text-xs bg-white"
    >
      <div class="md:absolute fixed right-4 top-6">
        <Download href={cvFileName(info.name)} />
      </div>
      <div class="h-full flex flex-col md:flex-row print:flex-row">
        <div class="md:w-1/3 print:w-1/3">
          <Header
            education={info.education}
            website={info.website}
            email={info.email}
            github={info.github}
            jobDescription={info.jobDescription}
            linkedin={info.linkedin}
            location={info.location}
            name={info.name}
            languages={info.languages}
          />
        </div>
        <div class="md:w-2/3 print:w-2/3 h-full p-4 flex flex-col space-y-4">
          <section>
            {info.about.map((about) => <p>{about}</p>)}
          </section>
          <Experience experience={info.experience} website={info.website} />
          <Projects projects={info.projects} />
        </div>
      </div>
    </main>
  </div>
</BaseLayout>
