---
import MinimalLayout from "../layouts/MinimalLayout.astro";

import IntroSection from "../components/cv/IntroSection.astro";
import ExperienceSection from "../components/cv/ExperienceSection.astro";
import Download from "../components/Download.astro";

import { info } from "../content/cv/en";

function cvFileName(name: string):string {
  return `${name.toLowerCase().replaceAll(" ", "_")}.pdf`
}

---

<MinimalLayout title={info.name}>
  <div class="not-prose absolute right-4 top-4">
    <Download href={cvFileName(info.name)}/>
  </div>
  <IntroSection
    name={info.name}
    jobDescription={info.jobDescription}
    location={info.location}
    website={info.website}
    email={info.email}
    about={info.about} />

  <ExperienceSection experience={info.experience}/>
</MinimalLayout>
